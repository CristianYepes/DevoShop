# Puerto HTTP (Cloud Run usa 8080)
PORT=8080

# Clave de la API de Gemini (Google AI Studio). Si se omite, funciona el motor local de respaldo.
GEMINI_API_KEY=

# Modelo ligero y rápido recomendado para mantener la mediana <= 3s
GEMINI_MODEL=gemini-2.5-flash-lite

# Rutas locales y/o URLs para cargar catálogo y condiciones dinámicamente al arrancar
CATALOG_PATH=/app/data/catalogo.json
CATALOG_URL=
CONDITIONS_PATH=/app/data/condiciones-de-venta.md
CONDITIONS_URL=

# Refresco periódico opcional cuando se usan URLs (0 = solo al arrancar)
DATA_REFRESH_SECONDS=0

# Timeout de llamada al LLM en milisegundos y TTL de caché en segundos
LLM_TIMEOUT_MS=4500
CACHE_TTL_SECONDS=300
